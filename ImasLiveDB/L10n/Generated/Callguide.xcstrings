    "callguide.dashboard.dropped" : {
      "comment" : "サーバにはあるが端末の曲一覧に無いので出せない曲の数の断り書き。1000 以上は桁区切りが付く (今も同じ) (i18n/catalog/callguide.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg 曲は、この端末の曲一覧に出ない曲 (別バージョン等) のため表示していません。"
                    }
                  }
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%#@count@"
