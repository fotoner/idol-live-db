        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 앱은 아이돌마스터 시리즈의 비공식 팬 메이드 앱이에요. BANDAI NAMCO Entertainment 등의 권리자와는 아무런 관계가 없어요."
          }
        }
