          }
        }
      }
    },
    "help.category.events.attended.detail" : {
      "comment" : "ヘルプ「ライブを探す」の項目の説明。「参加した」はライブ詳細のトグルの文言 (ko はそちらの訳に合わせる) (i18n/catalog/help.json)",
      "extractionState" : "manual",
      "localizations" : {
