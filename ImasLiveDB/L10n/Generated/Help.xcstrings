    },
    "help.category.calendar.open.detail" : {
      "comment" : "ヘルプ「カレンダー」の項目の説明 (i18n/catalog/help.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月単位で全アイマスイベントを俯瞰。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "월 단위로 모든 아이마스 이벤트를 한눈에 볼 수 있어요."
          }
        }
      }
    },
    "help.category.calendar.open.label" : {
      "comment" : "ヘルプ「カレンダー」の項目の見出し。iOS の文言 (カレンダーの場所。Android は label_android)。タブの名前は nav.tab.* の訳に合わせる (i18n/catalog/help.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロデュースタブ → カレンダー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "프로듀스 탭 → 캘린더"
          }
        }
      }
    },
    "help.category.calendar.summary" : {
      "comment" : "ヘルプの機能カテゴリ「カレンダー」の一行説明 (一覧の行の見出しの下と詳細画面の先頭) (i18n/catalog/help.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ・CD リリース・アイドル誕生日を月別に表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "라이브·CD 발매·아이돌 생일을 월별로 보여 줘요."
          }
        }
      }
    },
    "help.category.calendar.title" : {
      "comment" : "ヘルプの機能カテゴリ「カレンダー」の名前 (一覧の行の見出しと詳細画面のタイトル) (i18n/catalog/help.json)",
