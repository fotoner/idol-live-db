    "help.category.events.brand_filter.detail" : {
      "comment" : "ヘルプ「ライブを探す」の項目の説明。ブランドの略称は ko のファンが使う呼び方にした (ヴイアラは正式表記の vα-liv) (i18n/catalog/help.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の絞り込みボタンから、765AS / シンデレラ / ミリオン / SideM / シャニ / 学マス / ヴイアラ など特定ブランドだけに絞れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오른쪽 위의 필터 버튼에서 765AS / 신데렐라 / 밀리언 / SideM / 샤니 / 학원 / vα-liv 등 특정 브랜드만 골라 볼 수 있어요."
          }
        }
      }
    },
    "help.category.events.brand_filter.label" : {
      "comment" : "ヘルプ「ライブを探す」の項目の見出し (i18n/catalog/help.json)",
