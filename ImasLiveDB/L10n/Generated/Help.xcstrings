    "help.category.calendar.colors.detail" : {
      "comment" : "ヘルプ「カレンダー」の項目の説明 (i18n/catalog/help.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれ別色で表示。タップで詳細にジャンプ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각각 다른 색으로 표시돼요. 탭하면 상세로 이동해요."
          }
        }
      }
    },
    "help.category.calendar.colors.label" : {
      "comment" : "ヘルプ「カレンダー」の項目の見出し (i18n/catalog/help.json)",
