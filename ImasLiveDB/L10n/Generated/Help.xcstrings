        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "상세 화면에서 “참가함”을 켜면 마이페이지의 참가 횟수에 더해져요."
          }
        }
      }
    },
    "help.category.events.attended.label" : {
