    "games.daily_pick.lead.idol" : {
      "comment" : "日替わりピック (アイドルの日) の先頭の説明 (i18n/catalog/games.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ブランドから今日のアイドルをピックしました。性格でも髪型でも口ぐせでも、思いついたタグを付けて投票しよう（複数OK・同じタグは人数が貯まります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "브랜드마다 오늘의 아이돌을 골랐어요. 성격이든 헤어스타일이든 말버릇이든, 떠오르는 태그를 달아 투표해 봐요 (여러 개 가능·같은 태그는 투표한 사람 수가 합산돼요)."
          }
        }
      }
    },
    "games.daily_pick.lead.song" : {
      "comment" : "日替わりピック (曲の日) の先頭の説明 (i18n/catalog/games.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ブランドから今日の1曲をピックしました。ジャケットをタップで試聴、気になる曲にタグを付けて投票しよう（複数OK・同じタグは人数が貯まります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "브랜드마다 오늘의 한 곡을 골랐어요. 재킷을 탭하면 미리 듣기를 할 수 있어요. 마음에 드는 곡에 태그를 달아 투표해 봐요 (여러 개 가능·같은 태그는 투표한 사람 수가 합산돼요)."
          }
        }
      }
    },
