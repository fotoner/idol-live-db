    },
    "events.attendance_sheet.footer_ios" : {
      "comment" : "参加シートの説明。Android は attendance_sheet.footer_android (括弧の補足が無い) (i18n/catalog/events.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公演ごとに参加形態を選べます（配信・ライブビューイングは開催があった公演のみ）。回収率には現地参加だけが数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "공연마다 참가 형태를 고를 수 있어요 (스트리밍·라이브 뷰잉은 해당 형태로 진행된 공연만). 회수율에는 현장 참가만 집계돼요."
          }
        }
      }
    },
    "events.attendance_sheet.per_show_header" : {
