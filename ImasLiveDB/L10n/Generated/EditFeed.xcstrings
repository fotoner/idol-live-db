    "edit_feed.login_sheet.message" : {
      "comment" : "ログインの誘導シートの説明 (i18n/catalog/edit_feed.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ・公演・セトリ・楽曲の情報は、ログインしたユーザーみんなで編集できます。誤りの修正や新しいライブの追加に、ぜひ協力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "라이브·공연·세트리스트·곡 정보는 로그인한 사용자 모두가 함께 편집할 수 있어요. 잘못된 정보를 고치거나 새 라이브를 추가하는 데 꼭 힘을 보태 주세요."
          }
        }
      }
    },
    "edit_feed.login_sheet.point.browse" : {
      "comment" : "ログインの誘導シートの箇条書き (3 つ目) (i18n/catalog/edit_feed.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閲覧はログイン不要。編集する時だけログインします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "보기만 할 때는 로그인하지 않아도 돼요. 편집할 때만 로그인해요"
          }
        }
