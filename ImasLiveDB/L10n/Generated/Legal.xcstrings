        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーに関するお問い合わせ・データ削除依頼は下記 GitHub Issue からお願いします。\nhttps://github.com/fuga-if/imas-live-privacy/issues/new"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "개인정보 관련 문의·데이터 삭제 요청은 아래 GitHub Issue로 해 주세요.\nhttps://github.com/fuga-if/imas-live-privacy/issues/new"
          }
