      }
    },
    "settings.account.edit_name.message" : {
      "comment" : "表示名の変更ダイアログの説明。max = 上限の文字数 (コアが決める。今は 40 なので桁区切りは付かない) (i18n/catalog/settings.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@max@"
          },
          "substitutions" : {
            "max" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "コミュニティ投稿で表示される名前です (%arg文字以内)"
                    }
                  }
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%#@max@"
          },
          "substitutions" : {
            "max" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "needs_review",
                      "value" : "커뮤니티 게시물에 표시되는 이름이에요 (%arg자 이내)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
