    "settings.account.edit_name.error_rate_limited" : {
      "comment" : "表示名の変更が 1 日の上限に達したとき (429) (i18n/catalog/settings.json)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はこれ以上、表示名を変更できません。明日また試してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오늘은 더 이상 표시 이름을 바꿀 수 없어요. 내일 다시 시도해 주세요"
          }
        }
      }
    },
    "settings.account.edit_name.error_title" : {
      "comment" : "表示名を保存できなかったときのダイアログの見出し (i18n/catalog/settings.json)",
