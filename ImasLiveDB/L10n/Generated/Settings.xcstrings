        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "삭제하지 못했어요"
          }
        }
      }
    },
    "settings.account.edit_name.a11y" : {
      "comment" : "名前の右の鉛筆ボタンの読み上げ (i18n/catalog/settings.json)",
