    <!-- help.category.penlight.results.detail: ヘルプ「ペンライト投票」の項目の説明 -->
    <string name="help_category_penlight_results_detail">投票結果は色セット別の票数で表示。ライブ前の「色合わせ」用にどうぞ。</string>
    <!-- help.category.penlight.results.label: ヘルプ「ペンライト投票」の項目の見出し -->
    <string name="help_category_penlight_results_label">集計結果を確認</string>
    <!-- help.category.penlight.summary: ヘルプの機能カテゴリ「ペンライト投票」の一行説明 (一覧の行の見出しの下と詳細画面の先頭) -->
    <string name="help_category_penlight_summary">曲ごとの「振る色」をみんなで投票して可視化。</string>
    <!-- help.category.penlight.title: ヘルプの機能カテゴリ「ペンライト投票」の名前 (一覧の行の見出しと詳細画面のタイトル) -->
    <string name="help_category_penlight_title">ペンライト投票</string>
    <!-- help.category.penlight.vote.detail: ヘルプ「ペンライト投票」の項目の説明 -->
    <string name="help_category_penlight_vote_detail">公式パレットの中から、その曲で振りたい色 (単色 / 複数色) を選んで投票できます。</string>
    <!-- help.category.penlight.vote.label: ヘルプ「ペンライト投票」の項目の見出し -->
    <string name="help_category_penlight_vote_label">曲詳細から好きな色セットを投票</string>
    <!-- help.category.search.aliases.detail: ヘルプ「検索」の項目の説明。ロコ・伴田路子 はアイドル名 (データ。検索も ja の名前で引く) なので訳さない。シャニ・ミリはブランドの略称 (ko のファンの呼び方にする。events.brand_filter と揃える) -->
    <string name="help_category_search_aliases_detail">「ロコ」と検索しても「伴田路子」がヒット。シャニやミリの別名表記も内部で名寄せ済み。</string>
    <!-- help.category.search.aliases.label: ヘルプ「検索」の項目の見出し -->
    <string name="help_category_search_aliases_label">アイドル別名にも対応</string>
    <!-- help.category.search.fallback.detail: ヘルプ「検索」の項目の説明。「全体から検索」は検索結果が無いときに出るボタンの文言 (ko はそちらの訳に合わせる) -->
    <string name="help_category_search_fallback_detail">タブ内検索で結果が無いときは「全体から検索」ボタンが出ます。同じ語句のまま 1 タップで横断検索に切り替えられます。</string>
    <!-- help.category.search.fallback.label: ヘルプ「検索」の項目の見出し -->
    <string name="help_category_search_fallback_label">見つからなければ全体検索へ</string>
    <!-- help.category.search.global.detail_android: ヘルプ「検索」の項目の説明。Android の文言 (全体検索のボタンが右上にある) -->
    <string name="help_category_search_global_detail_android">右上の虫眼鏡から、楽曲・アイドル・ライブをまとめて横断検索できます。タブをまたいで一気に目的の項目へ飛べます。</string>
    <!-- help.category.search.global.label: ヘルプ「検索」の項目の見出し -->
    <string name="help_category_search_global_label">全体検索 = 横断して探す</string>
    <!-- help.category.search.in_tab.detail: ヘルプ「検索」の項目の説明。ライブ / 楽曲 / アイドル は下のタブの名前 (nav.tab.* の訳に合わせる) -->
    <string name="help_category_search_in_tab_detail">ライブ / 楽曲 / アイドル 各タブの検索バーは、いま表示中の一覧 (適用中の絞り込みも含む) をその場で絞り込みます。</string>
    <!-- help.category.search.in_tab.label: ヘルプ「検索」の項目の見出し -->
    <string name="help_category_search_in_tab_label">タブ内検索 = この一覧を絞り込む</string>
    <!-- help.category.search.summary: ヘルプの機能カテゴリ「検索」の一行説明 (一覧の行の見出しの下と詳細画面の先頭) -->
    <string name="help_category_search_summary">「このタブを絞り込む」検索と、「全体を横断する」検索の 2 種類があります。</string>
    <!-- help.category.search.title: ヘルプの機能カテゴリ「検索」の名前 (一覧の行の見出しと詳細画面のタイトル) -->
    <string name="help_category_search_title">検索</string>
    <!-- help.category.songs.collect_filter.detail: ヘルプ「楽曲を探す」の項目の説明。「回収済」は楽曲のマイマークの文言 (ko はそちらの訳に合わせる) -->
    <string name="help_category_songs_collect_filter_detail">マイマークで「回収済」を付けた曲だけ、または未回収だけを表示できます。</string>
    <!-- help.category.songs.collect_filter.label: ヘルプ「楽曲を探す」の項目の見出し -->
    <string name="help_category_songs_collect_filter_label">回収済 / 未回収で絞り込み</string>
    <!-- help.category.songs.history.detail: ヘルプ「楽曲を探す」の項目の説明 -->
    <string name="help_category_songs_history_detail">曲詳細から「どのライブで何回歌われたか」を一覧表示。担当曲の披露頻度がわかります。</string>
    <!-- help.category.songs.history.label: ヘルプ「楽曲を探す」の項目の見出し -->
    <string name="help_category_songs_history_label">歌唱履歴で深掘り</string>
    <!-- help.category.songs.original_members.detail: ヘルプ「楽曲を探す」の項目の説明 -->
    <string name="help_category_songs_original_members_detail">曲のアイコン群はオリジナル歌唱メンバー (ライブ歌唱者ではなく)。ユニット曲はユニット名で表示されます。</string>
    <!-- help.category.songs.original_members.label: ヘルプ「楽曲を探す」の項目の見出し -->
    <string name="help_category_songs_original_members_label">オリジナルメンバーを表示</string>
    <!-- help.category.songs.preview.detail: ヘルプ「楽曲を探す」の項目の説明。Android だけの項目 (iOS は songs.apple_music)。配信のある曲 = 音楽配信サービスにある曲。ジャケ写 = ジャケット写真 -->
    <string name="help_category_songs_preview_detail">配信のある曲は 30 秒のプレビューを再生できます。ジャケ写も自動取得。</string>
    <!-- help.category.songs.preview.label: ヘルプ「楽曲を探す」の項目の見出し。Android だけの項目 (iOS は songs.apple_music)。配信のある曲 = 音楽配信サービスにある曲。ジャケ写 = ジャケット写真 -->
    <string name="help_category_songs_preview_label">試聴とジャケ写</string>
    <!-- help.category.songs.summary: ヘルプの機能カテゴリ「楽曲を探す」の一行説明 (一覧の行の見出しの下と詳細画面の先頭) -->
    <string name="help_category_songs_summary">2300曲以上を曲名・アルバム・シリーズで探索できます。</string>
    <!-- help.category.songs.title: ヘルプの機能カテゴリ「楽曲を探す」の名前 (一覧の行の見出しと詳細画面のタイトル) -->
    <string name="help_category_songs_title">楽曲を探す</string>
    <!-- help.category.songs.view_modes.detail: ヘルプ「楽曲を探す」の項目の説明 -->
    <string name="help_category_songs_view_modes_detail">曲一覧 / アルバムグリッド / シリーズグリッド を絞り込みパネルから切り替え可能。</string>
    <!-- help.category.songs.view_modes.label: ヘルプ「楽曲を探す」の項目の見出し -->
    <string name="help_category_songs_view_modes_label">3 つの表示モード</string>
    <!-- help.category.sync.cloudkit.detail: ヘルプ「同期とアカウント」の項目の説明 -->
    <string name="help_category_sync_cloudkit_detail">新しいライブやセトリは CloudKit から差分配信されます。アプリ更新を待たずに最新化されます。</string>
    <!-- help.category.sync.cloudkit.label: ヘルプ「同期とアカウント」の項目の見出し -->
    <string name="help_category_sync_cloudkit_label">マスタデータは CloudKit で自動同期</string>
    <!-- help.category.sync.delete_account.detail: ヘルプ「同期とアカウント」の項目の説明。「アカウントを削除」はマイページのボタンの文言 (ko はそちらの訳に合わせる) -->
    <string name="help_category_sync_delete_account_detail">マイページ → アカウントを削除 で、サーバー上の編集履歴とユーザー情報をすべて削除します。</string>
    <!-- help.category.sync.delete_account.label: ヘルプ「同期とアカウント」の項目の見出し -->
    <string name="help_category_sync_delete_account_label">アカウント削除も可能</string>
    <!-- help.category.sync.login.detail: ヘルプ「同期とアカウント」の項目の説明 -->
    <string name="help_category_sync_login_detail">閲覧機能には不要。データを編集したい時だけログインしてください。</string>
    <!-- help.category.sync.login.label_android: ヘルプ「同期とアカウント」の項目の見出し。Android の文言 (iOS は Sign in with Apple) -->
    <string name="help_category_sync_login_label_android">Google ログインは編集用</string>
    <!-- help.category.sync.summary: ヘルプの機能カテゴリ「同期とアカウント」の一行説明 (一覧の行の見出しの下と詳細画面の先頭)。Android でも ja は Sign in with Apple のまま (文面の見直しはオーナーが別 PR で)。ko は Apple の公式表記『Apple로 로그인』(ボタンの表示と同じ) -->
    <string name="help_category_sync_summary">CloudKit で常に最新のデータ、 Sign in with Apple で編集に参加。</string>
    <!-- help.category.sync.title: ヘルプの機能カテゴリ「同期とアカウント」の名前 (一覧の行の見出しと詳細画面のタイトル) -->
    <string name="help_category_sync_title">同期とアカウント</string>
    <!-- help.category.tags.attach.detail: ヘルプ「タグ」の項目の説明 -->
    <string name="help_category_tags_attach_detail">曲詳細から既存のタグを付けたり、新しいタグを作って付けたりできます。</string>
    <!-- help.category.tags.attach.label: ヘルプ「タグ」の項目の見出し -->
    <string name="help_category_tags_attach_label">曲にタグを付ける</string>
    <!-- help.category.tags.browse.detail: ヘルプ「タグ」の項目の説明。「夏曲」「バラード」「神曲」はタグの例 (例も訳す) -->
    <string name="help_category_tags_browse_detail">タグ一覧 → タグ詳細から、そのタグが付いた曲を一覧表示。「夏曲」「バラード」「神曲」など好きな切り口で検索可能。</string>
    <!-- help.category.tags.browse.label: ヘルプ「タグ」の項目の見出し -->
    <string name="help_category_tags_browse_label">タグから曲を辿る</string>
    <!-- help.category.tags.description.detail: ヘルプ「タグ」の項目の説明 -->
    <string name="help_category_tags_description_detail">誰でもタグの説明を書き加えられます。Wikipedia のような共同編集スタイル。</string>
    <!-- help.category.tags.description.label: ヘルプ「タグ」の項目の見出し -->
    <string name="help_category_tags_description_label">タグの説明文を編集</string>
    <!-- help.category.tags.summary: ヘルプの機能カテゴリ「タグ」の一行説明 (一覧の行の見出しの下と詳細画面の先頭) -->
    <string name="help_category_tags_summary">ユーザー投稿のタグで曲を自由に分類できます。</string>
    <!-- help.category.tags.title: ヘルプの機能カテゴリ「タグ」の名前 (一覧の行の見出しと詳細画面のタイトル) -->
    <string name="help_category_tags_title">タグ</string>
