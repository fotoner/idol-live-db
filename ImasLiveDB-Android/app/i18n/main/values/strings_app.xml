    <!-- app.boot.recovery.detail: 復旧画面の下に小さく出す技術的な詳細。detail はエラーの本文 (訳さない) -->
    <string name="app_boot_recovery_detail">詳細: %1$s</string>
    <!-- app.boot.recovery.message: 復旧画面の説明。データは消していないので再インストールは勧めない -->
    <string name="app_boot_recovery_message">端末に保存しているデータを開く途中で問題が起きました。データは消えていません。もう一度試しても開けないときは、アプリを最新版に更新してください。</string>
    <!-- app.boot.recovery.retry: 復旧画面のボタン。DB をもう一度開く -->
    <string name="app_boot_recovery_retry">もう一度試す</string>
